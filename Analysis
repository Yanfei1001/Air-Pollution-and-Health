# 1. Load libraries
# ----------------------------------------------------------------------------
library(R2jags)
library(coda)
library(ggplot2)
library(GGally)
library(dplyr)
library(loo)
library(runjags)

# 2. Data Cleaning
# ----------------------------------------------------------------------------

# 3. Model Fitting
# ----------------------------------------------------------------------------
# ALL 6 POLLUTANTS IN LATENT SPACE:
# PM2.5, PM10, SO2, NO2, CO, O3, Temp
# ----------------------------------------------------------------------------

# Create Y matrix with ALL pollutants (all 6)
Y <- cbind(
  log(df$PM2.5) - mean(log(df$PM2.5)),
  log(df$PM10) - mean(log(df$PM10)),
  log(df$SO2) - mean(log(df$SO2)),
  log(df$NO2) - mean(log(df$NO2)),
  log(df$CO) - mean(log(df$CO)),
  log(df$O3) - mean(log(df$O3))
)

# Filter only the first 258 timepoints
Y <- Y[1:258, ]
N <- 258
N1 <- 258

# Number of pollutants in latent space (ALL 6)
K_total <- 6

# Number of pollutants in outcome model (SUBSET: PM2.5, PM10, O3)
# Note: K_out will be used for beta_out dimension
K_out <- 4  # PM2.5, PM10, O3

# Which pollutants go into outcome model? (1-indexed)
# PM2.5 = 1, PM10 = 2, SO2 = 3, NO2 = 4, CO = 5, O3 = 6
outcome_indices <- c(1, 2, 5, 6)  # PM2.5, PM10, O3

# 4. Singular value decomposition Transformation
# ----------------------------------------------------------------------------
svd_res <- svd(scale(Y, center = TRUE, scale = FALSE))
Q <- svd_res$v
Y_rot <- t(Q) %*% t(Y)
Y_rot <- t(Y_rot)  # N x K_total

# Sin and Cos for explaining the seasonal pattern
n_harmonics <- 1
sin_terms <- matrix(NA, nrow = N, ncol = n_harmonics)
cos_terms <- matrix(NA, nrow = N, ncol = n_harmonics)
for (h in 1:n_harmonics) {
  sin_terms[, h] <- sin(2 * pi * h * (1:N) / 52)
  cos_terms[, h] <- cos(2 * pi * h * (1:N) / 52)
}

# 5. Prepare Data for the jags model
# ----------------------------------------------------------------------------
data_jags <- list(
  Y = Y_rot,
  Y_out = data$COPD[2:(N1+1)],
  N = N,
  N1 = N1,
  K_total = K_total,           # Total pollutants in latent space
  K_out = K_out,               # Pollutants in outcome model
  outcome_indices = outcome_indices,  # Which pollutants are in outcome
  pi = pi,
  tv = 1:N,
  sin_harmonics = sin_terms,
  cos_harmonics = cos_terms,
  n_harmonics = n_harmonics,
  lam = 1/52,
  yv = df$Temperature[1:N],
  offset = data$Population[2:(N1+1)],
  Q = Q
)

# 6. Define the model
# ----------------------------------------------------------------------------
model_string_flexible <- "
model {

  # 1. Latent states with flexible seasonal structure
  # ----------------------------------------------------------
  for (k in 1:K_total) {
    # Base mean with trend and flexible seasonal
    for (t in 1:N) {
      mu_base[t,k] <- a[k] + b[k]*t + 
                     inprod(beta_harmonic[k, 1:n_harmonics], sin_harmonics[t, 1:n_harmonics]) + 
                     inprod(beta_harmonic_cos[k, 1:n_harmonics], cos_harmonics[t, 1:n_harmonics])
    }
    
    # AR(1) structure
    adjusted_mu[1,k] <- mu_base[1,k]
    for (t in 2:N) {
      adjusted_mu[t,k] <- mu_base[t,k] + rho[k] * (Z_star[t-1,k] - mu_base[t-1,k])
    }
    
    # Block sampling for latent states
    for (t in 1:N) {
      Z_star[t,k] ~ dnorm(adjusted_mu[t,k], tau_proc[k])
    }
  }
  # ----------------------------------------------------------

  # 2. Measurement model
  # ----------------------------------------------------------
  for (t in 1:N) {
    for (k in 1:K_total) {
      Y[t,k] ~ dnorm(Z_star[t,k], tau_me[k])
    }
  }
  # ----------------------------------------------------------

  # 3. Back-transformation to original scale
  # ----------------------------------------------------------
  for (t in 1:N) {
    for (j in 1:K_total) {
      muY_orig[t,j] <- inprod(Q[j,1:K_total], Z_star[t,1:K_total])
    }
  }

  # 4. Outcome model - using SUBSET of pollutants
  # ----------------------------------------------------------
  for (t in 1:N1) {
    # Only use the specified subset of pollutants for outcome
    log_lambda[t] <- alpha + 
                     inprod(beta_out[1:K_out], muY_orig[t, outcome_indices[1:K_out]]) + 
                     gamma * yv[t] + log(offset[t])
    lambda[t] <- exp(log_lambda[t])
    Y_out[t] ~ dpois(lambda[t])
  }
  # ----------------------------------------------------------

  # 5. Hierarchical priors
  # ----------------------------------------------------------
  tau_beta_harmonic ~ dgamma(0.5, 0.5)
  tau_beta_out ~ dgamma(0.5, 0.5)
  
  for (k in 1:K_total) {
    rho[k] ~ dnorm(0, 1)
    tau_proc[k] ~ dgamma(0.5, 0.5)
    tau_me[k] ~ dgamma(0.5, 0.5)
    a[k] ~ dnorm(0, 0.01)
    b[k] ~ dnorm(0, 0.01)
    
    for (h in 1:n_harmonics) {
      beta_harmonic[k, h] ~ dnorm(0, tau_beta_harmonic)
      beta_harmonic_cos[k, h] ~ dnorm(0, tau_beta_harmonic)
    }
  }

  # 6. Outcome model parameters - dimension K_out
  # ----------------------------------------------------------
  beta_out[1:K_out] ~ dmnorm(mu_beta_out[1:K_out], prec_beta_out[1:K_out, 1:K_out])
  
  for (k in 1:K_out) {
    mu_beta_out[k] <- 0
  }
  
  for (i in 1:K_out) {
    for (j in 1:K_out) {
      prec_beta_out[i, j] <- ifelse(i == j, tau_beta_out, 0)
    }
  }
  
  alpha ~ dnorm(0, 0.01)
  gamma ~ dnorm(0, 0.01)
}
"

# 7. Set the Initial values
# ----------------------------------------------------------------------------
inits_function_flexible <- function() {
  list(
    Z_star = Y_rot + matrix(rnorm(N*K_total, 0, 0.1), N, K_total),
    rho = rnorm(K_total, 0, 0.3),
    tau_proc = rgamma(K_total, 1, 1),
    tau_me = rgamma(K_total, 1, 1),
    beta_harmonic = matrix(rnorm(K_total * n_harmonics, 0, 0.05), K_total, n_harmonics),
    beta_harmonic_cos = matrix(rnorm(K_total * n_harmonics, 0, 0.05), K_total, n_harmonics),
    beta_out = rnorm(K_out, 0, 0.05),
    a = rnorm(K_total, 0, 0.1),
    b = rnorm(K_total, 0, 0.01),
    tau_beta_harmonic = rgamma(1, 0.5, 0.5),
    tau_beta_out = rgamma(1, 0.5, 0.5),
    alpha = rnorm(1, 0, 0.1),
    gamma = rnorm(1, 0, 0.1)
  )
}

# 8. Run the jags model
# ----------------------------------------------------------------------------
n_chains <- 3
n_burnin <- 10000
n_post <- 3000
n_adapt <- 10
n_thin <- 1

vars_monitor <- c("beta_out", "gamma", "alpha", "rho", "tau_proc", "tau_me",
                  "beta_harmonic", "beta_harmonic_cos", "lambda", 
                  "muY_orig", "Z_star", "tau_beta_out", "a", "b")

n_rep <- 1
mu_hat <- numeric(n_rep)
p <- K_out + 2  # beta_out (K_out) + gamma + alpha
theta_hat <- matrix(NA, n_rep, p)
ci_array <- array(NA, dim = c(n_rep, p, 2))

for (r in 1:n_rep) {
  data_jags <- list(
    Y = Y_rot,
    Y_out = data$COPD[2:(N1+1)],
    N = N,
    N1 = N1,
    K_total = K_total,
    K_out = K_out,
    outcome_indices = outcome_indices,
    pi = pi,
    tv = 1:N,
    sin_harmonics = sin_terms,
    cos_harmonics = cos_terms,
    n_harmonics = n_harmonics,
    lam = 1/52,
    yv = df$Temperature[1:N],
    offset = data$Population[2:(N1+1)],
    Q = Q
  )
  
  results <- run.jags(
    model = model_string_flexible,
    data = data_jags,
    monitor = vars_monitor,
    n.chains = n_chains,
    burnin = n_burnin,
    sample = n_post,
    thin = n_thin,
    adapt = n_adapt,
    method = "parallel",
    modules = "glm",
    inits = replicate(n_chains, inits_function_flexible(), simplify = FALSE),
    silent.jags = FALSE
  )
  
  post <- as.matrix(as.mcmc(results))
  keep <- c(paste0("beta_out[", 1:K_out, "]"), "gamma", "alpha")
  post_sub <- post[, keep]
  theta_hat[r, ] <- colMeans(post_sub)
  ci <- apply(post_sub, 2, quantile, c(0.025, 0.975))
  ci_array[r, , 1] <- ci[1, ]
  ci_array[r, , 2] <- ci[2, ]
}

